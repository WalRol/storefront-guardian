        "number": { "type": ["integer", "null"] },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"] }
      }
    },
    "label": { "type": "string" },
    "verdict": { "type": "string", "enum": ["APPROVE", "REVIEW", "BLOCK"] },
