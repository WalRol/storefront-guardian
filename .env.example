# Copia este archivo como .env y completa SOLO el proveedor que vayas a usar.
# El archivo .env está en .gitignore: nunca se commitea.

# Proveedor por defecto: gemini | groq | ollama | replay | none
GUARDIAN_PROVIDER=replay

# Google AI Studio (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, requiere ~8 GB de RAM libres para un modelo de 7B)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
