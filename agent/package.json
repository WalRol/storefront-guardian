{
  "name": "storefront-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Pipeline de agentes que revisa PRs, propone correcciones validadas y decide si el cambio puede avanzar",
  "type": "module",
  "bin": {
    "guardian": "src/cli.ts"
  },
  "scripts": {
    "guardian": "tsx src/cli.ts",
    "eval": "tsx src/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export-dashboard": "tsx src/export-dashboard.ts"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
