+/** Devuelve el token de un header "Bearer <token>", o cadena vacía si no aplica. */
+export function extractBearerToken(header: string | undefined): string {
+  if (!header?.startsWith('Bearer ')) return '';
+  return header.slice(7).trim();
+}
