+function couponDiscountFor(
+  promotions: Promotion[],
+  code: string | undefined,
+  eligibleCents: number,
+): number {
+  if (!code) return 0;
+  const coupon = promotions.find(
+    (p): p is Extract<Promotion, { type: 'COUPON_FIXED' }> =>
+      p.type === 'COUPON_FIXED' && p.code === code,
+  );
+  return coupon && eligibleCents > coupon.minPurchaseCents ? coupon.amountCents : 0;
